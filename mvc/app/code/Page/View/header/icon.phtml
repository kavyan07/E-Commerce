<?php
/**
 * Icon / Profile Dropdown Template
 * File   : app/code/Page/View/header/icon.phtml
 * Block  : Page_Block_Header_Icon
 *
 * Renders the profile icon button and its dropdown menu.
 * Session logic lives entirely in Page_Block_Header_Icon — not here.
 */
$isLoggedIn   = $this->isLoggedIn();
$userName     = $this->getUserName();
$userEmail    = $this->getUserEmail();
$userInitial  = $this->getUserInitial();
$dropdownItems = $isLoggedIn
    ? $this->getLoggedInItems()
    : $this->getGuestItems();
?>

<div class="header-profile" id="header-profile">

    <!-- ── Profile Toggle Button ── -->
    <button
        class="profile-btn"
        id="profile-toggle-btn"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="profile-dropdown-menu"
        aria-label="Account menu"
    >
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
        </svg>
        <?php if ($isLoggedIn): ?>
            <span class="status-dot" aria-hidden="true"></span>
        <?php endif; ?>
    </button>

    <!-- ── Dropdown Panel ── -->
    <div
        class="profile-dropdown"
        id="profile-dropdown-menu"
        role="menu"
        aria-label="Account options"
    >

        <?php if ($isLoggedIn): ?>
            <!-- Logged-in header: avatar + name + email -->
            <div class="dropdown-user-info" aria-hidden="true">
                <div class="dropdown-avatar"><?php echo $userInitial; ?></div>
                <div class="dropdown-user-details">
                    <div class="dropdown-user-name"><?php echo $userName; ?></div>
                    <div class="dropdown-user-email"><?php echo $userEmail; ?></div>
                </div>
            </div>
        <?php else: ?>
            <!-- Guest header -->
            <div class="dropdown-guest-info" aria-hidden="true">
                <div class="dropdown-guest-avatar">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <div class="dropdown-guest-text">
                    <div class="guest-title">Welcome, Guest</div>
                    <div class="guest-sub">Sign in to your account</div>
                </div>
            </div>
        <?php endif; ?>

        <!-- Dropdown action items (dynamic from block) -->
        <div class="dropdown-items">
            <?php foreach ($dropdownItems as $item): ?>
                <?php if (!empty($item['divider_before'])): ?>
                    <div class="dropdown-divider" role="separator"></div>
                <?php endif; ?>
                <a
                    href="<?php echo $item['url']; ?>"
                    class="<?php echo $item['class']; ?>"
                    role="menuitem"
                    id="<?php echo $item['id']; ?>"
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <?php echo $item['icon']; ?>
                    </svg>
                    <?php echo $item['label']; ?>
                </a>
            <?php endforeach; ?>
        </div>

    </div><!-- /.profile-dropdown -->
</div><!-- /.header-profile -->
