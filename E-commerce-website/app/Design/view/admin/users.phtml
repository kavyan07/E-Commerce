        <a href="/E-commerce-website/admin/logout" class="logout-btn">🚪 Logout</a>
    </div>
</aside>

<div class="main-content">
    <div class="topbar">
        <h2>👥 Registered Customers</h2>
    </div>

    <div class="page-body">
        <div class="content-card">
            <div class="card-header">
                <h3>All Customers (<?= count($users ?? []) ?>)</h3>
                <input type="text" class="search-input" placeholder="Search by name or email..." onkeyup="filterUsers(this.value)">
            </div>

            <?php if (empty($users)): ?>
                <div style="text-align:center;padding:4rem;color:var(--text-muted);">No customers registered yet.</div>
            <?php else: ?>
            <table class="data-table" id="usersTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email / Phone</th>
                        <th>Orders</th>
                        <th>Lifetime Spend</th>
                        <th>Joined Date</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($users as $u): ?>
                    <tr>
                        <td><span class="user-id-badge">UID-<?= $u['id'] ?></span></td>
                        <td><strong style="color:white;"><?= htmlspecialchars($u['first_name'] . ' ' . $u['last_name']) ?></strong></td>
                        <td>
                            <div><?= htmlspecialchars($u['email']) ?></div>
                            <small style="color:var(--text-muted);"><?= htmlspecialchars($u['phone'] ?? 'No phone') ?></small>
                        </td>
                        <td><?= $u['order_count'] ?> orders</td>
                        <td><strong style="color:var(--success);">₹<?= number_format($u['lifetime_value'] ?? 0, 2) ?></strong></td>
                        <td><?= date('d M Y', strtotime($u['created_at'])) ?></td>
                    </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
            <?php endif; ?>
        </div>
    </div>
</div>

<script>
function filterUsers(q) {
    q = q.toLowerCase();
    document.querySelectorAll('#usersTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
</script>
