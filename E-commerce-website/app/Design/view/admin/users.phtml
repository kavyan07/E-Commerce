            <div class="admin-avatar"><?= strtoupper(substr($_SESSION['admin_user']['username'] ?? 'A', 0, 1)) ?></div>
            <div>
                <div class="admin-name"><?= htmlspecialchars($_SESSION['admin_user']['username'] ?? 'Admin') ?></div>
                <div class="admin-role">Super Admin</div>
            </div>
