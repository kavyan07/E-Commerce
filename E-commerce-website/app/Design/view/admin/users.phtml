        .data-table tr:hover td { background: rgba(255,255,255,0.02); }
        .user-id-badge { background: var(--dark2); padding: 0.25rem 0.5rem; border-radius: 6px; font-family: monospace; font-size: 0.8rem; color: var(--primary); }
