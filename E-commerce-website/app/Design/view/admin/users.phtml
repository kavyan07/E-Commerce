        .admin-badge { background: linear-gradient(135deg, var(--primary), var(--accent)); color: white; font-size: 0.6rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 4px; letter-spacing: 1px; text-transform: uppercase; margin-top: 0.2rem; }
