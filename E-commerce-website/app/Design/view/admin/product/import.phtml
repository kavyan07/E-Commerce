                    <div class="alert alert-error">❌ <?= htmlspecialchars($import_msg) ?></div>
                <?php endif; ?>

                <form method="POST" enctype="multipart/form-data" action="/E-commerce-website/admin/product/import">
                    <label class="import-box" for="product_csv">
                        <span class="import-icon">📄</span>
                        <p>Click to select or drag your CSV file here</p>
                        <input type="file" name="product_csv" id="product_csv" accept=".csv" class="hidden-file" required onchange="updateFileName(this)">
                        <div id="fileName" class="file-name"></div>
                    </label>
                    <button type="submit" class="btn" style="width:100%; justify-content:center;">🚀 Start Import</button>
