<script>
function updateFileName(input) {
    const file = input.files[0];
    const nameDiv = document.getElementById('fileName');
    if (file) {
        nameDiv.textContent = 'Selected: ' + file.name;
        nameDiv.style.display = 'block';
    } else {
        nameDiv.style.display = 'none';
    }
}
</script>
