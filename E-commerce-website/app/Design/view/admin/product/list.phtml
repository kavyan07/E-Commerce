    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #6c5ce7; --primary-dark: #5a4bd1; --secondary: #00cec9;
            --accent: #fd79a8; --success: #00b894; --warning: #fdcb6e;
